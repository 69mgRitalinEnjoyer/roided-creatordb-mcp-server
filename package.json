{
  "name": "roided-creatordb-mcp-server",
  "version": "0.1.0",
  "description": "CreatorDB MCP server with a server-side workspace: the official tools, whole-list pulls and a live table, without filling the model's context",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:table": "node scripts/preview-table.mjs"
  },
  "dependencies": {
    "@creatordbai/mcp-server": "1.13.1",
    "@electric-sql/pglite": "^0.5.17",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  }
}
