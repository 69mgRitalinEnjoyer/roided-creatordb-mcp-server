# Port to listen on.
PORT=8787

# The server's public address, with no trailing slash. File links, sign-in and the live table use it.
PUBLIC_URL=http://localhost:8787

# Postgres connection string. Leave empty to use the embedded database in DATA_DIR.
DATABASE_URL=

# Where the embedded database and result files are kept.
DATA_DIR=./data

# Seals sign-in codes, encrypts stored API keys and signs file links.
# Required when NODE_ENV=production. Use a long random value and keep it secret.
TOKEN_SECRET=

# A reply with more rows than this comes back as a summary and a file.
REPLY_ROW_LIMIT=50

# How long pull_list holds its call open before it reports progress, in milliseconds.
PULL_WAIT_MS=110000
